{
  "name": "financebro-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/services/bot/main.js",
    "db:generate": "drizzle-kit generate --config services/core/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config services/core/drizzle.config.ts",
    "test": "node --test test/parser.test.ts test/telegram.test.ts test/analytics-http.test.ts test/input.test.ts",
    "test:integration": "node --test test/accounting.test.ts test/migrations.test.ts test/analytics.test.ts test/structured-operations.test.ts test/input-context.test.ts test/telegram-core-http.test.ts test/operation-input-client.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "services/*"
  ]
}
