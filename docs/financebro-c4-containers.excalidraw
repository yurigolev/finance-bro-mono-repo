      "fontSize": 16,
      "fontFamily": 3,
      "text": "{\n  \"transcript\": \"В прошлый вторник кофе в путешествии 400р\",\n  \"draft\": {\n    \"kind\": \"expense\",\n    \"amountKopecks\": \"40000\",\n    \"currency\": \"RUB\",\n    \"description\": \"кофе в путешествии\",\n    \"operationDate\": {\n      \"date\": \"2026-11-17\",\n      \"timeZone\": \"Asia/Yekaterinburg\"\n    }\n  },\n  \"categoryCandidates\": [\n    {\n      \"id\": \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\",\n      \"kind\": \"expense\",\n      \"name\": \"Кафе\"\n    },\n    {\n      \"id\": \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\",\n      \"kind\": \"expense\",\n      \"name\": \"Путешествия\"\n    }\n  ],\n  \"needsClarification\": [\n    \"operationDate\",\n    \"categoryId\"\n  ],\n  \"dateConfirmation\": {\n    \"dates\": [\n      \"2026-11-17\"\n    ],\n    \"today\": \"2026-11-24\",\n    \"timeZone\": \"Asia/Yekaterinburg\"\n  }\n}",
      "originalText": "{\n  \"transcript\": \"В прошлый вторник кофе в путешествии 400р\",\n  \"draft\": {\n    \"kind\": \"expense\",\n    \"amountKopecks\": \"40000\",\n    \"currency\": \"RUB\",\n    \"description\": \"кофе в путешествии\",\n    \"operationDate\": {\n      \"date\": \"2026-11-17\",\n      \"timeZone\": \"Asia/Yekaterinburg\"\n    }\n  },\n  \"categoryCandidates\": [\n    {\n      \"id\": \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\",\n      \"kind\": \"expense\",\n      \"name\": \"Кафе\"\n    },\n    {\n      \"id\": \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\",\n      \"kind\": \"expense\",\n      \"name\": \"Путешествия\"\n    }\n  ],\n  \"needsClarification\": [\n    \"operationDate\",\n    \"categoryId\"\n  ],\n  \"dateConfirmation\": {\n    \"dates\": [\n      \"2026-11-17\"\n    ],\n    \"today\": \"2026-11-24\",\n    \"timeZone\": \"Asia/Yekaterinburg\"\n  }\n}",
      "rawText": "{\n  \"transcript\": \"В прошлый вторник кофе в путешествии 400р\",\n  \"draft\": {\n    \"kind\": \"expense\",\n    \"amountKopecks\": \"40000\",\n    \"currency\": \"RUB\",\n    \"description\": \"кофе в путешествии\",\n    \"operationDate\": {\n      \"date\": \"2026-11-17\",\n      \"timeZone\": \"Asia/Yekaterinburg\"\n    }\n  },\n  \"categoryCandidates\": [\n    {\n      \"id\": \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\",\n      \"kind\": \"expense\",\n      \"name\": \"Кафе\"\n    },\n    {\n      \"id\": \"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb\",\n      \"kind\": \"expense\",\n      \"name\": \"Путешествия\"\n    }\n  ],\n  \"needsClarification\": [\n    \"operationDate\",\n    \"categoryId\"\n  ],\n  \"dateConfirmation\": {\n    \"dates\": [\n      \"2026-11-17\"\n    ],\n    \"today\": \"2026-11-24\",\n    \"timeZone\": \"Asia/Yekaterinburg\"\n  }\n}",
